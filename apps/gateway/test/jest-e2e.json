{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../../..",
  "roots": ["<rootDir>/apps/gateway/test/"],
  "testEnvironment": "node",
  "setupFiles": [
    "reflect-metadata",
    "<rootDir>/apps/gateway/test/setup-e2e.ts"
  ],
  "setupFilesAfterEnv": [
    "<rootDir>/apps/gateway/test/notifications-queue-e2e.ts"
  ],
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "astTransformers": {
          "before": [
            "<rootDir>/apps/gateway/test/swagger-plugin-transformer.js"
          ]
        }
      }
    ]
  },
  "moduleNameMapper": {
    "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1"
  }
}
