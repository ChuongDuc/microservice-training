// Prisma schema cho USER SERVICE
// Mỗi service có schema + client riêng (nguyên tắc "mỗi service một DB").

generator client {
  provider = "prisma-client-js"
  // Xuất client vào thư mục riêng của service để không đè lên client của service khác
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("USER_DATABASE_URL")
}

// Vai trò người dùng (dùng cho phân quyền RBAC ở các giai đoạn sau).
enum Role {
  USER
  ADMIN
}

// Trạng thái tài khoản người dùng.
enum UserStatus {
  ACTIVE
  BLOCKED
}

// Hồ sơ người dùng do USER SERVICE quản lý.
// LƯU Ý: KHÔNG có field password — thông tin xác thực (password/credential)
// thuộc về AUTH SERVICE (ranh giới nghiệp vụ giữa hai service).
model User {
  id          String     @id @default(uuid())
  email       String     @unique
  displayName String
  avatar      String? // nullable: người dùng có thể chưa đặt ảnh đại diện
  role        Role       @default(USER)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}
