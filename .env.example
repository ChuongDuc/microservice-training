# ============================================================
#  MẪU CẤU HÌNH MÔI TRƯỜNG
#  Copy file này thành `.env` rồi chỉnh giá trị thật.
#  `.env` KHÔNG được commit (đã nằm trong .gitignore).
# ============================================================

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
AUTH_DB_NAME=auth_db
USER_DB_NAME=user_db
TASK_DB_NAME=task_db

# ---- Prisma connection strings (mỗi service một DB) ----
USER_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/user_db?schema=public
AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_db?schema=public
TASK_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/task_db?schema=public

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- RabbitMQ ----
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_QUEUE=notifications_queue

# ---- Cổng TCP nội bộ giữa các microservice ----
# *_HOST: địa chỉ phía gọi (Gateway/Auth) kết nối tới.
# *_BIND_HOST: địa chỉ service lắng nghe. Mặc định 127.0.0.1 vì service trong tin danh
# tính người gọi trong payload — chỉ Gateway được phép gọi tới. Trong Docker đặt 0.0.0.0
# và không publish cổng 4001-4003 ra ngoài.
AUTH_SERVICE_HOST=localhost
AUTH_SERVICE_BIND_HOST=127.0.0.1
AUTH_SERVICE_PORT=4001
USER_SERVICE_HOST=localhost
USER_SERVICE_BIND_HOST=127.0.0.1
USER_SERVICE_PORT=4002
TASK_SERVICE_HOST=localhost
TASK_SERVICE_PORT=4003

# ---- API Gateway (cổng HTTP public) ----
GATEWAY_PORT=3000

# ---- JWT ----
# BẮT BUỘC đổi: Gateway/Auth không khởi động với giá trị mẫu dưới đây, secret ngắn hơn
# 32 ký tự, hoặc access trùng refresh. Tạo secret ngẫu nhiên:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=doi_secret_nay_thanh_chuoi_ngau_nhien_dai
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=doi_secret_refresh_nay_thanh_chuoi_khac
JWT_REFRESH_EXPIRES_IN=7d
